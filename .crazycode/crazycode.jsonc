  "instructions": ["STYLE_GUIDE.md"],
  "provider": {
    "crazycode": {
      "options": {},
    },
    "tailnet-vllm": {
      "name": "Tailnet vLLM",
      "npm": "@ai-sdk/openai-compatible",
      "env": [],
      "models": {
        "glm4-flash": {
          "id": "mlx-community/GLM-4.7-Flash-4bit",
          "name": "GLM 4.7 Flash",
          "tool_call": true,
        },
      },
      "options": {
        "apiKey": "not-needed",
        "baseURL": "http://Adams-Mac-Studio:8000/v1",
      },
    },
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
    },
  },
  "tools": {
    "github-triage": false,
    "github-pr-search": false,
  },
}
